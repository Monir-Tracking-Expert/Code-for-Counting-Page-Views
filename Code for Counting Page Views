<script>
(function() {
  var pageViewCount = parseInt(localStorage.getItem('page_view_count')) || 0;
  pageViewCount++;
  localStorage.setItem('page_view_count', pageViewCount);
  
  // Fire event when user has viewed 7+ pages (lifetime)
  if (pageViewCount >= 7) {  // Changed === to >=
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({
      event: 'highly_engaged_visitor',
      total_page_views: pageViewCount
    });
  }
})();
</script>
